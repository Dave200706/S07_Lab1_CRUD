@model ZombieParty.ViewModels.ZombieTypeVM
<form method="post" asp-action="Edit">
    <div class="border p-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group row">
            <h2 class="text-info pl-3">Zombie Type</h2>
            <hr />
        </div>

        <div class="row">
            <div class="col-8">
                <div class="form-group row">
                    <div class="col-2">
                        <label asp-for="ZombieType.TypeName"></label>
                    </div>
                    <div class="col-8">
                        <input asp-for="ZombieType.TypeName" class="form-control" />
                        <span asp-validation-for="ZombieType.TypeName" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-2">
                        <label asp-for="ZombieType.Point" class="col-form-label"></label>
                    </div>
                    <div class="col-8">
                        <input asp-for="ZombieType.Point" class="form-control" />
                        <span asp-validation-for="ZombieType.Point" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row py-2">
                    <div class="col-8 offset-2 row">
                        <div class="col">
                            <input type="submit" class="btn btn-info w-100" value="Edit" />
                        </div>
                        <div class="col">
                            <a asp-action="Index" class="btn btn-success w-100">Back to list</a>
                        </div>
                    </div>
                </div>

            </div>
            <div class="col-4">
            </div>
        </div>
    </div>
</form>
@section Scripts{

    @{
        <partial name="_ValidationScriptsPartial" />
    }

}